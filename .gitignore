# Godot 4+ specific ignores
.godot/
/android/

# Python tooling
__pycache__/
*.pyc

# Godot generates import sidecars for review screenshots; they are not game assets.
docs/reviews/*.import

# Generated, reproducible full history/culture sample dumps.
# Keep curated review packets, evaluations, small statistics, and test fixtures tracked.
/docs/reviews/history_v4/samples.json
/docs/reviews/history_v4/samples.md
/docs/reviews/history_v4_redesign/samples.json
/docs/reviews/history_v4_redesign/samples.md
/docs/reviews/social_incidents_v1/samples.json
/docs/reviews/faction_culture_v1/samples.json

# M045 reproducible machine-readable histories; readable review packet stays tracked.
/docs/reviews/history_v6/samples.json
/docs/reviews/history_v6/pilot/samples.json
/docs/reviews/history_v6/pilot/samples.md

# Documentation diagram imports
docs/diagrams/*.import
