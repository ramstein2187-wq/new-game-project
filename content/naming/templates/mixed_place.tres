[gd_resource type="Resource" script_class="NameTemplate" load_steps=5 format=3]

[ext_resource type="Script" path="res://game/naming/name_template.gd" id="template"]
[ext_resource type="Script" path="res://game/naming/name_slot.gd" id="slot"]

[sub_resource type="Resource" id="proper"]
script = ExtResource("slot")
id = "proper"
kind = 0
token_pools = Array[PackedStringArray]([PackedStringArray("vei", "na", "to", "se", "lu", "mi", "da", "ke", "zo", "fu", "ha", "bo"), PackedStringArray("ra", "len", "rin", "mon", "sen", "lith", "vak", "nar", "dor", "wen", "sil", "mar")])

[sub_resource type="Resource" id="feature"]
script = ExtResource("slot")
id = "feature"
kind = 1
token_pools = Array[PackedStringArray]([PackedStringArray("WELL", "GATE", "MARSH", "REACH", "RUIN")])

[resource]
script = ExtResource("template")
id = "mixed_place"
name_types = PackedStringArray("mixed_location")
slots = Array[ExtResource("slot")]([SubResource("proper"), SubResource("feature")])
patterns = {
  "en": "{proper} {feature}",
  "ko": "{proper} {feature}"
}
