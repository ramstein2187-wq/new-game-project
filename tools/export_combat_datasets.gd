extends SceneTree

const OUTPUT_DIR := "res://docs/datasets/"
const AUTHORITY := "content/catalog.tres"
const SOURCE_LIST := "res://tools/combat_dataset_sources.json"

func _init() -> void:
	var data := CombatContentCatalog.content()
	if data == null:
		quit(1)
		return
	var outputs := {"equipment.json": equipment(data), "monsters.json": monsters(data)}
	var manifest := {"generated_by": "tools/export_combat_datasets.gd", "sources": {}, "outputs": {}}
	var paths: Array[String] = []
	for path: String in JSON.parse_string(FileAccess.get_file_as_string(SOURCE_LIST)):
		collect_sources(path, paths)
	paths.sort()
	for path in paths:
		manifest.sources[path] = normalized_hash("res://" + path)
	var check := "--check" in OS.get_cmdline_user_args()
	var failed := false
	for name: String in outputs:
		var serialized := JSON.stringify(outputs[name], "  ") + "\n"
		manifest.outputs["docs/datasets/" + name] = serialized.sha256_text()
		failed = not write_or_check(OUTPUT_DIR + name, serialized, check) or failed
	failed = not write_or_check(OUTPUT_DIR + "combat_content_manifest.json", JSON.stringify(manifest, "  ") + "\n", check) or failed
	print("Combat datasets " + ("checked" if check else "generated"))
	quit(1 if failed else 0)

func collect_sources(path: String, result: Array[String]) -> void:
	if DirAccess.dir_exists_absolute("res://" + path):
		for file in DirAccess.get_files_at("res://" + path):
			if file.ends_with(".gd") or file.ends_with(".tres"):
				result.append(path.path_join(file))
		for directory in DirAccess.get_directories_at("res://" + path):
			collect_sources(path.path_join(directory), result)
	else:
		result.append(path)

func normalized_hash(path: String) -> String:
	return FileAccess.get_file_as_string(path).replace("\r\n", "\n").sha256_text()

func write_or_check(path: String, text: String, check: bool) -> bool:
	if check:
		if FileAccess.get_file_as_string(path).replace("\r\n", "\n") != text:
			push_error("Stale generated dataset: " + path + "; run tools/export_combat_datasets.gd")
			return false
	else:
		var file := FileAccess.open(path, FileAccess.WRITE)
		if file == null:
			push_error("Cannot write " + path)
			return false
		file.store_string(text)
	return true

func equipment(data: CombatContentData) -> Dictionary:
	var result := {"version": 4, "runtime_authority": AUTHORITY,
		"normal_melee_action_cost": AttackAction.BASE_COST, "armor_profiles": [], "weapons": [], "armor": [],
		"notes": ["Generated by tools/export_combat_datasets.gd; edit content/*.tres instead.",
			"Weapon data has no action_cost, attack_speed or weapon_speed field.",
			"Armor is single-layer per body part; supplied prototype loadouts do not overlap natural and equipment armor.",
			"Armor profile IDs are extensible catalog data; omitted damage types use a neutral x1.0 multiplier."]}
	for id in ArmorProfileCatalog.PROFILE_MULTIPLIERS:
		var multipliers := {}
		for type in [AttackDefinition.DAMAGE_CUT, AttackDefinition.DAMAGE_PUNCTURE, AttackDefinition.DAMAGE_BLUNT]:
			multipliers[type] = ArmorProfileCatalog.multiplier_for(id, type)
		result.armor_profiles.append({"id": id, "multipliers": multipliers, "default_multiplier": 1.0})
	for item in data.weapons:
		var attack := item.attack_definition
		var actions := []
		for action in item.actions:
			actions.append({"id": action.id, "display_name": action.display_name, "cost_percent": action.cost_percent,
				"damage_type_override": action.damage_type_override, "penetration_modifier": action.penetration_modifier,
				"damage_modifier": action.damage_modifier, "situation_modifier": action.situation_modifier})
		result.weapons.append({"id": item.id, "name": item.display_name,
			"damage": {"count": attack.damage_dice.dice_count, "size": attack.damage_dice.dice_size, "ability": attack.ability_rule},
			"damage_type": attack.damage_type, "penetration": attack.penetration, "required_hands": item.required_hands,
			"required_capability": attack.required_capability, "properties": item.properties, "weapon_actions": actions})
	for item in data.armor:
		result.armor.append({"id": item.id, "name": item.display_name, "armor": item.armor, "coverage": item.coverage, "profile": item.profile})
	return result

func monsters(data: CombatContentData) -> Dictionary:
	var defaults := ActorDefinition.new()
	var result := {"version": 3, "runtime_authority": AUTHORITY,
		"defaults": {"unspecified_ability_score": AbilityScores.new().scores[&"STR"],
			"proficiency_bonus": defaults.proficiency_bonus, "normal_melee_action_cost": AttackAction.BASE_COST,
			"threat_rating": null, "taxonomy": {"origin": null, "composition": null, "cognition": null, "combat_roles": [], "behavior_motivations": []}},
		"notes": ["hp is fresh Actor resolved Max HP with authored initial CON and no active Effects; ActorDefinition.max_hp is Base HP."],
		"records": []}
	# Preserve the established dataset order with Rat first.
	var entries: Array[CombatActorContent] = []
	for entry in data.actors:
		if entry.definition.type_id == &"rat":
			entries.append(entry)
	for entry in data.actors:
		if entry.definition.type_id != &"rat":
			entries.append(entry)
	for entry: CombatActorContent in entries:
		var item := entry.instantiate_definition()
		var runtime := Actor.new(item.type_id, item, Vector2i.ZERO)
		var game := TimeCostGame.new()
		game.actors = ActorRegistry.new()
		game.actors.register(runtime)
		var abilities := {}
		for key in AbilityScores.NAMES:
			abilities[key] = runtime.abilities.scores[key]
		var record := {"id": item.type_id, "name": item.display_name, "body_template_id": entry.body_template_id,
			"hp": runtime.max_hp, "abilities": abilities, "movement_speed": item.movement_speed,
			"move": [MoveAction.new(Vector2i.RIGHT).get_cost(game, runtime.id), MoveAction.new(Vector2i(1, 1)).get_cost(game, runtime.id)],
			"natural_armor": item.natural_armor, "natural_armor_profile": item.natural_armor_profile,
			"ai_policy": item.ai_policy, "aggression": item.aggression, "body_size": entry.body_size,
			"proficiency_bonus": item.proficiency_bonus, "ability_points": item.ability_points,
			"interact_cost": InteractAction.BASE_COST, "wait_cost": WaitAction.BASE_COST, "threat_rating": null}
		if item.equipped_weapon != null:
			record["weapon"] = item.equipped_weapon.id
		else:
			var attack := item.attack_definition
			record["attack"] = {"id": attack.id, "damage": attack.damage_dice.notation() + " + " + String(attack.ability_rule),
				"type": attack.damage_type, "penetration": attack.penetration, "capability": attack.required_capability}
		if not item.equipped_armor.is_empty():
			record["armor"] = item.equipped_armor.map(func(piece: ArmorDefinition) -> StringName: return piece.id)
		result.records.append(record)
	return result
